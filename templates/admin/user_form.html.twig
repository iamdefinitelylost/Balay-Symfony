{% extends 'panel/base.html.twig' %}

{% block title %}{{ mode == 'new' ? 'New account' : 'Edit account' }} – Balay admin{% endblock %}

{% block content %}
<form class="info panel" method="post" action="{{ mode == 'new' ? path('app_admin_user_new') : path('app_admin_user_edit', {id: user.id}) }}">
  <h2>{{ mode == 'new' ? 'Create admin / staff account' : 'Edit account' }}</h2>
  {% for e in errors %}<p class="err" role="alert">{{ e }}</p>{% endfor %}
  <label>Name<input name="name" value="{{ form.name }}" maxlength="80" required></label>
  <label>Email<input type="email" name="email" value="{{ form.email }}" maxlength="120" required></label>
  <label>Role
    <select name="role"{{ is_self ? ' disabled' }}>
      {% for r in roles %}<option value="{{ r }}"{{ form.role == r ? ' selected' }}>{{ r|capitalize }}</option>{% endfor %}
    </select>
  </label>
  {% if is_self %}<p class="meta">You cannot change your own role.</p>{% endif %}
  {% if mode == 'new' %}
    <label>Password (8+ characters)<input type="password" name="password" minlength="8" autocomplete="new-password" required></label>
  {% endif %}
  <input type="hidden" name="_token" value="{{ csrf_token('user_form') }}">
  <button class="btn" type="submit">{{ mode == 'new' ? 'Create account' : 'Save changes' }}</button>
  <a class="meta" href="{{ path('app_admin_users') }}">Cancel</a>
</form>

{% if mode == 'edit' %}
<form class="info panel" method="post" action="{{ path('app_admin_user_reset', {id: user.id}) }}">
  <h2>Reset password</h2>
  <p class="meta">Sets a new password for {{ user.name }}. They will be logged out and must sign in again.</p>
  <label>New password (8+ characters)<input type="password" name="new_password" minlength="8" autocomplete="new-password" required></label>
  <input type="hidden" name="_token" value="{{ csrf_token('user_action') }}">
  <button class="btn" type="submit">Reset password</button>
</form>
{% endif %}
{% endblock %}
