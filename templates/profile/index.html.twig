{% extends 'panel/base.html.twig' %}

{% block title %}My profile – Balay{% endblock %}

{% block content %}
<div class="info panel">
  <h2>My profile</h2>
  <div class="row"><span class="meta">Name</span><b>{{ me.name }}</b></div>
  <div class="row"><span class="meta">Email</span><b>{{ me.email }}</b></div>
  <div class="row"><span class="meta">Role</span><span class="pill {{ me.role }}">{{ me.role }}</span></div>
  <div class="row"><span class="meta">Account created</span><b>{{ me.createdAt|date('Y-m-d') }}</b></div>
  <a class="btn" href="{{ path('app_profile_password') }}">Change password</a>
</div>
{% endblock %}
