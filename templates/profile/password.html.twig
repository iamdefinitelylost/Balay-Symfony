{% extends 'panel/base.html.twig' %}

{% block title %}Change password – Balay{% endblock %}

{% block content %}
<form class="info panel" method="post" action="{{ path('app_profile_password') }}">
  <h2>Change my password</h2>
  {% for e in errors %}<p class="err" role="alert">{{ e }}</p>{% endfor %}
  <label>Current password<input type="password" name="current_password" autocomplete="current-password" required></label>
  <label>New password (8+ characters)<input type="password" name="new_password" autocomplete="new-password" minlength="8" required></label>
  <label>Confirm new password<input type="password" name="confirm_password" autocomplete="new-password" minlength="8" required></label>
  <input type="hidden" name="_token" value="{{ csrf_token('change_password') }}">
  <button class="btn" type="submit">Save password</button>
  <a class="meta" href="{{ path('app_profile') }}">Cancel</a>
</form>
{% endblock %}
