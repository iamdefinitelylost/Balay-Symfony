{% extends 'base.html.twig' %}

{% block title %}Log in – Balay{% endblock %}

{% block body %}
<div class="wrap">
  <header class="top"><a class="logo" href="{{ path('home') }}"><i></i>balay</a></header>
  {% include 'panel/_flashes.html.twig' %}
  <form class="info panel" method="post" action="{{ path('app_login') }}">
    <h2>Staff &amp; admin login</h2>
    {% if error %}<p class="err" role="alert">{{ error }}</p>{% endif %}
    <label>Email<input type="email" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus></label>
    <label>Password<input type="password" name="_password" autocomplete="current-password" required></label>
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
    <button class="btn" type="submit">Log in</button>
    <a class="meta" href="{{ path('home') }}">Back to the site</a>
  </form>
</div>
{% endblock %}
